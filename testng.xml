<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SOF309 HNDD Billiards Automation Test Suite" verbose="1">

    <!-- Đăng ký Listener tự động chụp ảnh màn hình khi có Test thất bại -->
    <listeners>
        <listener class-name="com.poly.sof309.ui.listeners.TestListener" />
    </listeners>

    <!-- Test Suite: Smoke Test nhóm kịch bản trọng yếu -->
    <test name="Smoke Tests - Critical User Flows">
        <groups>
            <run>
                <include name="smoke" />
            </run>
        </groups>
        <classes>
            <class name="com.poly.sof309.ui.tests.LoginTest" />
        </classes>
    </test>

    <!-- Test Suite: Regression Test nhóm kiểm thử lặp dữ liệu biên -->
    <test name="Regression Tests - Data-Driven & Edge Cases">
        <groups>
            <run>
                <include name="regression" />
            </run>
        </groups>
        <classes>
            <class name="com.poly.sof309.ui.tests.LoginTest" />
        </classes>
    </test>

</suite>
